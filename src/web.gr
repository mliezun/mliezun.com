let http = import("http.gr")
let html = import("html.gr")
let router = import("router.gr")
let u = import("utils.gr")

class Web {
    init(include_feed) {
        this.renderer = html.Renderer()
        this.routes = router.get_routes(include_feed)
        this.renderPages()
    }


    addIf(condition, content) {
        if condition {
            return content
        }
        return ""
    }

    navLinkClass(active) {
        if active {
            return "masthead-nav-link is-active"
        }
        return "masthead-nav-link"
    }

    articleByline(metadata) {
        let tags = metadata["tags"]
        return ["p", ["class", "article-byline"], [
            ["span", ["class", "byline-date"], metadata["date"]],
            ["span", ["class", "byline-author"], metadata["author"]],
            this.addIf(
                tags != "",
                ["span", ["class", "byline-tags"], tags],
            ),
        ]]
    }

    findTitleIndex(children) {
        let i = 0
        for child in children {
            if type(child) == "list" and child.length >= 1 and child[0] == "h1" {
                return i
            }
            i = i + 1
        }
        i = 0
        for child in children {
            if type(child) == "list" and child.length >= 1 and child[0] == "h2" {
                return i
            }
            i = i + 1
        }
        return -1
    }

    injectArticleByline(articleChildren, byline) {
        let titleIx = this.findTitleIndex(articleChildren)
        if titleIx == -1 {
            return [byline] + articleChildren
        }
        let out = []
        let i = 0
        for child in articleChildren {
            out = out + [child]
            if i == titleIx {
                out = out + [byline]
            }
            i = i + 1
        }
        return out
    }

    injectBylineInContent(content, metadata) {
        let byline = this.articleByline(metadata)
        let out = []
        for item in content {
            if type(item) == "list" and item.length >= 3 and item[0] == "article" {
                let children = item[2]
                let injectedChildren = this.injectArticleByline(children, byline)
                let newArticle = ["article", item[1]] + [injectedChildren]
                out = out + [newArticle]
            } else {
                out = out + [item]
            }
        }
        return out
    }

    head(url, metadata) {
        let og_image = metadata["image"]
        if og_image != "" and not u.startswith(og_image, "http") {
            og_image = "https://mliezun.com" + og_image
        }
        if og_image == "" {
            og_image = "https://mliezun.com/assets/images/logo.png"
        }

        let description = metadata["excerpt"]
        if description == "" {
            description = metadata["title"] + " - by Miguel Liezun. Programming, side projects, and systems."
        }

        let og_image_meta = []
        if u.findSubstr(og_image, "logo.png") >= 0 {
            og_image_meta = [
                ["meta", ["property", "og:image:width", "content", "151"], []],
                ["meta", ["property", "og:image:height", "content", "105"], []],
                ["meta", ["property", "og:image:alt", "content", "Miguel Liezun"], []],
            ]
        }

        return ["head", [], [
            ["meta", ["charset", "UTF-8"], []],
            ["meta", ["http-equiv", "X-UA-Compatible", "content", "IE=edge"], []],
            ["meta", ["name", "viewport", "content", "width=device-width, initial-scale=1"], []],

            ["script", [], [
                "(function(){try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}})();",
            ]],

            ["title", [], metadata["title"]],

            ["meta", ["name", "generator", "content", "Custom"], []],
            ["meta", ["property", "og:title", "content", metadata["title"]], []],
            ["meta", ["property", "og:locale", "content", "en_US"], []],
            ["meta", ["name", "description", "content", description], []],
            ["meta", ["property", "og:description", "content", description], []],
            ["meta", ["name", "keywords", "content", metadata["tags"]], []],

            ["link", ["rel", "canonical", "href", "https://mliezun.com" + url], []],
            ["meta", ["property", "og:url", "content", "https://mliezun.com" + url], []],
            ["meta", ["property", "og:site_name", "content", "mliezun.com"], []],
            ["meta", ["property", "og:image", "content", og_image], []],
        ] + og_image_meta + [
            ["link", ["rel", "icon", "type", "image/png", "href", "/assets/images/favicon.png"], []],
            ["link", ["rel", "icon", "type", "image/x-icon", "href", "/assets/images/favicon.ico"], []],
            ["link", ["rel", "apple-touch-icon", "href", "/assets/images/favicon.png"], []],

            ["link", ["rel", "preconnect", "href", "https://fonts.googleapis.com"], []],
            ["link", ["rel", "preconnect", "href", "https://fonts.gstatic.com", "crossorigin", ""], []],
            ["link", ["rel", "stylesheet", "href", "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap"], []],

            this.addIf(
                metadata["content_type"],
                ["meta", ["property", "og:type", "content", metadata["content_type"]], []],
            ),
            ["meta", ["name", "twitter:card", "content", "summary_large_image"], []],
            ["meta", ["name", "twitter:title", "content", metadata["title"]], []],
            ["meta", ["name", "twitter:description", "content", description], []],
            ["meta", ["name", "twitter:creator", "content", "@migueliezun"]],
            ["meta", ["name", "twitter:image", "content", og_image], []],

            this.addIf(
                metadata["content_type"] != "article",
                ["script", ["type", "application/ld+json"], [
                    "{\"name\":\"mliezun.com\",\"description\":\"" + description + "\",\"@type\":\"WebSite\",\"url\":\"https://mliezun.com/\",\"headline\":\"" + metadata["title"] + "\",\"@context\":\"https://schema.org\"}",
                ]],
            ),

            this.addIf(
                metadata["content_type"] == "article",
                ["script", ["type", "application/ld+json"], [
                    "{\"description\":\"" + description + "\",\"author\":{\"@type\":\"Person\",\"name\":\"Miguel Liezun\"},\"@type\":\"BlogPosting\",\"url\":\"https://mliezun.com" + url + "\",\"headline\":\"" + metadata["title"] + "\",\"dateModified\":\"" + metadata["date"] + "T00:00:00-03:00\",\"datePublished\":\"" + metadata["date"] + "T00:00:00-03:00\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mliezun.com" + url + "\"},\"@context\":\"https://schema.org\"}"
                ]],
            ),

            ["link", ["rel", "stylesheet", "href", "/assets/css/style.css"], []],
            ["script", ["defer", "", "src", "/assets/js/gh-redirect.js"], []],
        ]]
    }

    masthead(url) {
        let isHome = url == "/"
        let isArchive = url == "/archive/index.html"
        let isNow = url == "/now/index.html"

        return ["header", ["class", "journal-masthead"], [
            ["div", ["class", "masthead-inner"], [
                ["div", ["class", "masthead-top"], [
                    ["a", ["href", "/", "class", "masthead-title"], "Miguel Liezun"],
                    ["div", ["class", "masthead-nav-row"], [
                        ["nav", ["class", "masthead-nav", "aria-label", "Site"], [
                            ["a", ["href", "/", "class", this.navLinkClass(isHome)], "Home"],
                            ["a", ["href", "/archive/index.html", "class", this.navLinkClass(isArchive)], "Archive"],
                            ["a", ["href", "/now/index.html", "class", this.navLinkClass(isNow)], "Now"],
                        ]],
                        ["button", ["class", "theme-toggle", "id", "theme-toggle", "title", "Toggle theme"], [
                            ["img", ["src", "/assets/images/circle-half.svg", "alt", "Toggle theme"], []],
                        ]],
                    ]],
                ]],
            ]],
        ]]
    }

    footer() {
        return ["footer", ["class", "site-footer"], [
            ["div", ["class", "footer-colophon"], [
                ["p", ["class", "footer-line"], [
                    "Published with ",
                    ["a", ["target", "_blank", "href", "https://github.com/mliezun/grotsky"], "Grotsky"],
                    ["a", ["target", "_blank", "href", "https://github.com/mliezun/mliezun.com"], "Source"],
                    ["a", ["href", "/feed.xml"], "RSS"],
                ]],
                ["p", ["class", "footer-line footer-links"], [
                    ["a", ["target", "_blank", "href", "https://github.com/mliezun"], "GitHub"],
                    ["a", ["target", "_blank", "href", "https://x.com/migueliezun"], "X"],
                    ["a", ["target", "_blank", "href", "https://www.linkedin.com/in/miguel-liezun-8697a9168/"], "LinkedIn"],
                ]],
            ]],
        ]]
    }

    body(content, metadata, url) {
        let hl = u.get(metadata, "needs_highlight", false)
        let mm = u.get(metadata, "needs_mermaid", false)
        let footer = [
            ["script", ["defer", "", "src", "/assets/js/theme-switcher.js"], []],
        ]
        if hl {
            footer = footer + [
                ["link", ["id", "hljs-theme", "rel", "stylesheet", "href", "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github.min.css"], []],
                ["script", ["defer", "", "src", "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"], []],
                ["script", ["defer", "", "src", "/assets/js/highlight-init.js"], []],
            ]
        }
        if mm {
            footer = footer + [
                ["script", ["defer", "", "src", "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"], []],
                ["script", ["defer", "", "src", "/assets/js/mermaid-init.js"], []],
            ]
        }
        return ["body", [], [
            this.masthead(url),
            ["div", ["class", "body-wrapper"], [
                ["main", ["class", "body-content"], content + [
                    this.footer(),
                ]],
            ]],
        ] + footer]
    }

    wrapBody(url, body, metadata) {
        return [
            ["!DOCTYPE HTML"],
            ["html", ["lang", "en-US", "data-theme", "auto"], [
                this.head(url, metadata),
                this.body(body, metadata, url),
            ]]
        ]
    }

    renderPages() {
        this.renderedPages = {}
        for url, route in this.routes {
            let page = ""
            if route["class"] == "html" {
                let content = route["content"]
                let metadata = route["metadata"]
                if u.get(metadata, "content_type", nil) == "article" {
                    let aiAssisted = u.get(metadata, "ai-assisted", false)
                    let aiTagDisplay = u.buildAITag(aiAssisted)
                    content = aiTagDisplay + this.injectBylineInContent(content, metadata)
                }
                let payload = this.wrapBody(url, content, metadata)
                page = this.renderer.render(payload)
            } elif route["class"] == "static" {
                page = route["content"]
            }
            this.renderedPages[url] = page
        }
    }

    buildAITagDisplay(aiAssisted) {
        return u.buildAITag(aiAssisted)
    }

    handleRq(rq, rw) {
        let page = nil

        try {
            page = this.renderedPages[rq.target]
        } catch err {
            io.println("Target not found: ", rq.target)
        }
        
        if page != nil {
            rw.setStatus("200").setBody(page)
        } else {
            this.handleNotFound(rq, rw)
        }
    }

    handleNotFound(rq, rw) {
        rw.setStatus("404").setBody("404 Not Found")
    }

    start(port) {
        this.server = http.Server("", port, this.handleRq)
        io.println("Listening on http://0.0.0.0:" + port)
        this.server.serve()
    }
}
