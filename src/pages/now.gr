let u = import("../utils.gr")


fn now_body() {
	return [
		["p", ["class", "journal-updated"], "Last updated on 2026-07-15."],
		["ul", ["class", "journal-list"], [
			["li", [], [
				"Working on ",
				["a", ["href", "https://github.com/mliezun/caddy-snake"], "caddy-snake"],
				", a plugin for the Caddy proxy that embeds the Python interpreter.",
			]],
			["li", [], [
				"Platform to run RISC-V CI/CD jobs at ",
				["a", ["href", "https://www.riscvrunners.com"], "riscvrunners.com"],
				".",
			]],
			["li", [], [
				"I've built Grotsky, a toy programming language made with Rust before LLMs. Sometimes I still poke around with it.",
			]],
			["li", [], [
				"Head of Engineering at ",
				["a", ["href", "https://foundational.bio"], "FoundationalBio"],
				", building the future of science.",
			]],
		]],
		["p", ["class", "journal-footnote"], [
			"More about the ",
			["a", ["href", "https://nownownow.com/"], "/now page"],
			"."
		]],
	]
}

fn build_now() {
    return [
        ["div", ["class", "journal-section"], [
            ["p", ["class", "journal-intro"], [
                "I'm Miguel Liezun. I write about programming, side projects, and the systems behind them. ",
                "I've built ",
                ["a", ["href", "https://mliezun.com/2023/11/23/grotsky-rust-part3.html"], "Grotsky"],
                ", a toy language implemented in Rust. This site is generated with Grotsky as static HTML.",
            ]],
            ["div", ["class", "journal-body"], now_body()],
        ]],
    ]
}
